# --- Base de datos ---
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=finanzas
POSTGRES_DB=finanzas
POSTGRES_PORT=5433
DATABASE_URL=postgresql://finanzas:finanzas@localhost:5433/finanzas?schema=public

# --- API ---
API_PORT=3001
WEB_URL=http://localhost:3000
# Genera secretos reales: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-access
JWT_REFRESH_SECRET=cambia-esto-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Pon false después de crear tu usuario (y siempre en producción)
ALLOW_REGISTRATION=true

# --- Tasas de cambio ---
# Zona horaria para decidir qué día es "hoy" y para el cron
APP_TIMEZONE=America/Caracas
# Por defecto 9:00 y 13:00 hora local (formato cron de 5 campos)
RATES_CRON=0 9,13 * * *
RATES_API_URL=https://ve.dolarapi.com/v1/dolares
# false desactiva el cron y la sincronización al arrancar
RATES_SYNC_ENABLED=true

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
