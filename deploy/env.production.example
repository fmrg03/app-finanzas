# Dominio que apunta a la IP del servidor (registro A). Caddy obtiene el certificado HTTPS solo.
DOMAIN=finanzas.tudominio.com

# Base de datos (usa una contraseña larga: openssl rand -base64 24)
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=finanzas

# Secretos JWT distintos y largos: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-access
JWT_REFRESH_SECRET=cambia-esto-refresh

# Pon true solo para crear tu usuario la primera vez; luego vuelve a false
ALLOW_REGISTRATION=false

# Lectura de facturas por foto (opcional): https://platform.claude.com
ANTHROPIC_API_KEY=

# Días de respaldos diarios de la base que se conservan
BACKUP_KEEP_DAYS=14
