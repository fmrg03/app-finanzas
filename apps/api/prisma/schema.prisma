generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  USD
  VES
}

enum RateSource {
  BCV
  PARALELO
  MANUAL
}

enum AccountType {
  CASH
  BANK
  CARD
  WALLET
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  IMPORT
  API
  RECEIPT
  RECURRING
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

enum DebtDirection {
  I_OWE
  OWED_TO_ME
}

enum NotificationType {
  BUDGET_NEAR
  BUDGET_EXCEEDED
  RECURRING_DUE
  DEBT_OVERDUE
  GOAL_REACHED
  GOAL_DEADLINE_NEAR
  GOAL_BEHIND
  GOAL_MISSED
}

enum ReceiptStatus {
  PENDING
  EXTRACTED
  CONFIRMED
  FAILED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  refreshTokenHash  String?
  defaultCurrency   Currency   @default(USD)
  defaultRateSource RateSource @default(BCV)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  receipts      Receipt[]
  transfers     Transfer[]
  recurrings    Recurring[]
  budgets       Budget[]
  goals         SavingsGoal[]
  debts         Debt[]
  notifications Notification[]
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  currency       Currency
  initialBalance Decimal     @default(0) @db.Decimal(18, 2)
  createdAt      DateTime    @default(now())
  archivedAt     DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  transfersFrom Transfer[]    @relation("TransferFrom")
  transfersTo   Transfer[]    @relation("TransferTo")
  recurrings    Recurring[]

  @@unique([userId, name])
}

model Category {
  id                String          @id @default(cuid())
  userId            String
  name              String
  type              TransactionType
  color             String          @default("#64748b")
  icon              String?
  parentId          String?
  // Tasa que se preselecciona al cargar un gasto de esta categoría
  defaultRateSource RateSource?
  createdAt         DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  recurrings   Recurring[]
  budget       Budget?

  @@unique([userId, parentId, name])
}

// Tasa diaria. rate = bolívares (VES) por 1 USD.
model ExchangeRate {
  id        String     @id @default(cuid())
  date      DateTime   @db.Date
  source    RateSource
  rate      Decimal    @db.Decimal(18, 6)
  fetchedAt DateTime   @default(now())

  transactions Transaction[]

  @@unique([date, source])
  @@index([date])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String?
  type        TransactionType
  date        DateTime        @db.Date
  description String?
  tags        String[]

  // Lo que el usuario escribió (en la moneda que eligió)
  originalCurrency Currency
  originalAmount   Decimal    @db.Decimal(18, 2)
  // Snapshot: ambos valores calculados al momento de la transacción (inmutables)
  amountUsd        Decimal    @db.Decimal(18, 2)
  amountVes        Decimal    @db.Decimal(18, 2)
  // Tasa exacta aplicada (VES por USD), copiada, no solo referenciada
  rateUsed         Decimal    @db.Decimal(18, 6)
  rateSource       RateSource
  exchangeRateId   String?

  // Preparación para automatización
  source     TransactionSource @default(MANUAL)
  externalId String?
  rawData    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  exchangeRate ExchangeRate? @relation(fields: [exchangeRateId], references: [id], onDelete: SetNull)
  receipt      Receipt?

  @@unique([userId, source, externalId])
  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, accountId])
}

model Receipt {
  id            String        @id @default(cuid())
  userId        String
  transactionId String?       @unique
  filePath      String
  fileHash      String
  extractedJson Json?
  status        ReceiptStatus @default(PENDING)
  modelUsed     String?
  confidence    Float?
  createdAt     DateTime      @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([userId, fileHash])
}

// Movimiento de dinero entre cuentas propias. No es ingreso ni gasto.
// Si las monedas difieren es un cambio de divisas: rate = Bs por USD obtenidos en la operación.
model Transfer {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  fromAccountId String
  toAccountId   String
  fromAmount    Decimal  @db.Decimal(18, 2)
  toAmount      Decimal  @db.Decimal(18, 2)
  rate          Decimal? @db.Decimal(18, 6)
  // Tasa BCV de ese día, para comparar el cambio obtenido
  referenceRate Decimal? @db.Decimal(18, 6)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([userId, date])
}

// Plantilla de un movimiento que se repite (sueldo, internet, Netflix)
model Recurring {
  id          String              @id @default(cuid())
  userId      String
  type        TransactionType
  accountId   String
  categoryId  String?
  currency    Currency
  amount      Decimal             @db.Decimal(18, 2)
  rateSource  RateSource?
  description String
  tags        String[]
  frequency   RecurrenceFrequency
  startDate   DateTime            @db.Date
  nextDate    DateTime            @db.Date
  endDate     DateTime?           @db.Date
  // true: se registra solo; false: queda pendiente para confirmar el monto
  autoCreate  Boolean             @default(false)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, nextDate])
}

// Tope mensual de gasto por categoría principal, en dólares
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String   @unique
  amountUsd  Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavingsGoal {
  id         String    @id @default(cuid())
  userId     String
  name       String
  targetUsd  Decimal   @db.Decimal(18, 2)
  targetDate DateTime? @db.Date
  // Aporte mensual que la persona se propone (opcional); si falta, se usa lo necesario para llegar a la fecha
  monthlyUsd Decimal?  @db.Decimal(18, 2)
  color      String    @default("#1f6f78")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
}

// Aporte (positivo) o retiro (negativo) de una meta
model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  date      DateTime @db.Date
  amountUsd Decimal  @db.Decimal(18, 2)
  note      String?
  createdAt DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

model Debt {
  id          String        @id @default(cuid())
  userId      String
  direction   DebtDirection
  person      String
  description String?
  currency    Currency
  amount      Decimal       @db.Decimal(18, 2)
  dueDate     DateTime?     @db.Date
  settledAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId])
}

model DebtPayment {
  id        String   @id @default(cuid())
  debtId    String
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(18, 2)
  note      String?
  createdAt DateTime @default(now())

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
}

// Aviso para el usuario. dedupeKey evita repetir el mismo aviso (ej. un presupuesto excedido una vez por mes).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}
