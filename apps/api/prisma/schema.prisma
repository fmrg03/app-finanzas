generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  USD
  VES
}

enum RateSource {
  BCV
  PARALELO
  MANUAL
}

enum AccountType {
  CASH
  BANK
  CARD
  WALLET
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  IMPORT
  API
  RECEIPT
  RECURRING
  INSTALLMENT
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

enum DebtDirection {
  I_OWE
  OWED_TO_ME
}

enum NotificationType {
  BUDGET_NEAR
  BUDGET_EXCEEDED
  RECURRING_DUE
  DEBT_OVERDUE
  GOAL_REACHED
  GOAL_DEADLINE_NEAR
  GOAL_BEHIND
  GOAL_MISSED
  INSTALLMENT_DUE
  INSTALLMENT_OVERDUE
  SHARED_WITH_ME
  FAMILY_JOINED
}

enum UserRole {
  ADMIN
  MEMBER
}

// Enlace de un solo uso: invitar a un familiar o restablecer una contraseña
enum InvitationKind {
  INVITE
  RESET
}

// Cómo se reparte un movimiento compartido
enum SplitMode {
  EQUAL
  PERCENT
  AMOUNT
}

// Cada cuánto vence una cuota de una compra en cuotas
enum InstallmentFrequency {
  DAYS_14
  DAYS_15
  MONTHLY
}

enum ReceiptStatus {
  PENDING
  EXTRACTED
  CONFIRMED
  FAILED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  refreshTokenHash  String?
  defaultCurrency   Currency   @default(USD)
  defaultRateSource RateSource @default(BCV)
  name              String?
  role              UserRole   @default(MEMBER)
  // Desactivado por el administrador: no puede entrar
  disabledAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  receipts         Receipt[]
  transfers        Transfer[]
  recurrings       Recurring[]
  budgets          Budget[]
  goals            SavingsGoal[]
  debts            Debt[]
  notifications    Notification[]
  persons          Person[]
  sharedExpenses   SharedExpense[]
  installmentPlans InstallmentPlan[]
  invitationsSent  Invitation[]      @relation("InvitationCreator")
  invitationsFor   Invitation[]      @relation("InvitationTarget")
  linkedPersons    Person[]          @relation("PersonLinkedUser")
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  currency       Currency
  initialBalance Decimal     @default(0) @db.Decimal(18, 2)
  createdAt      DateTime    @default(now())
  archivedAt     DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  transfersFrom    Transfer[]        @relation("TransferFrom")
  transfersTo      Transfer[]        @relation("TransferTo")
  recurrings       Recurring[]
  debtPayments     DebtPayment[]
  installmentPlans InstallmentPlan[]

  @@unique([userId, name])
}

model Category {
  id                String          @id @default(cuid())
  userId            String
  name              String
  type              TransactionType
  color             String          @default("#64748b")
  icon              String?
  parentId          String?
  // Tasa que se preselecciona al cargar un gasto de esta categoría
  defaultRateSource RateSource?
  createdAt         DateTime        @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategoryTree")
  transactions     Transaction[]
  recurrings       Recurring[]
  budget           Budget?
  installmentPlans InstallmentPlan[]

  @@unique([userId, parentId, name])
}

// Tasa diaria. rate = bolívares (VES) por 1 USD.
model ExchangeRate {
  id        String     @id @default(cuid())
  date      DateTime   @db.Date
  source    RateSource
  rate      Decimal    @db.Decimal(18, 6)
  fetchedAt DateTime   @default(now())

  transactions Transaction[]

  @@unique([date, source])
  @@index([date])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  // Vacío solo en gastos compartidos que pagó otra persona: tu parte cuenta como gasto pero no sale de tus cuentas
  accountId   String?
  categoryId  String?
  type        TransactionType
  date        DateTime        @db.Date
  description String?
  tags        String[]

  // Lo que el usuario escribió (en la moneda que eligió)
  originalCurrency Currency
  originalAmount   Decimal    @db.Decimal(18, 2)
  // Snapshot: ambos valores calculados al momento de la transacción (inmutables)
  amountUsd        Decimal    @db.Decimal(18, 2)
  amountVes        Decimal    @db.Decimal(18, 2)
  // Tasa exacta aplicada (VES por USD), copiada, no solo referenciada
  rateUsed         Decimal    @db.Decimal(18, 6)
  rateSource       RateSource
  exchangeRateId   String?

  // Lo que cuenta como gasto/ingreso tuyo (resumen, presupuestos). Igual al monto, salvo en compartidos
  myAmountUsd       Decimal  @db.Decimal(18, 2)
  myAmountVes       Decimal  @db.Decimal(18, 2)
  // Tu porcentaje en un movimiento compartido (null = 100 %)
  sharePct          Decimal? @db.Decimal(9, 6)
  sharedId          String?  @unique
  installmentPlanId String?

  // Preparación para automatización
  source     TransactionSource @default(MANUAL)
  externalId String?
  rawData    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  exchangeRate    ExchangeRate?    @relation(fields: [exchangeRateId], references: [id], onDelete: SetNull)
  receipt         Receipt?
  shared          SharedExpense?   @relation(fields: [sharedId], references: [id], onDelete: SetNull)
  installmentPlan InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  installment     Installment?

  @@unique([userId, source, externalId])
  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, accountId])
  @@index([installmentPlanId])
}

model Receipt {
  id            String        @id @default(cuid())
  userId        String
  transactionId String?       @unique
  filePath      String
  fileHash      String
  extractedJson Json?
  status        ReceiptStatus @default(PENDING)
  modelUsed     String?
  confidence    Float?
  createdAt     DateTime      @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([userId, fileHash])
}

// Movimiento de dinero entre cuentas propias. No es ingreso ni gasto.
// Si las monedas difieren es un cambio de divisas: rate = Bs por USD obtenidos en la operación.
model Transfer {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  fromAccountId String
  toAccountId   String
  fromAmount    Decimal  @db.Decimal(18, 2)
  toAmount      Decimal  @db.Decimal(18, 2)
  rate          Decimal? @db.Decimal(18, 6)
  // Tasa BCV de ese día, para comparar el cambio obtenido
  referenceRate Decimal? @db.Decimal(18, 6)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([userId, date])
}

// Plantilla de un movimiento que se repite (sueldo, internet, Netflix)
model Recurring {
  id          String              @id @default(cuid())
  userId      String
  type        TransactionType
  accountId   String
  categoryId  String?
  currency    Currency
  amount      Decimal             @db.Decimal(18, 2)
  rateSource  RateSource?
  description String
  tags        String[]
  frequency   RecurrenceFrequency
  startDate   DateTime            @db.Date
  nextDate    DateTime            @db.Date
  endDate     DateTime?           @db.Date
  // true: se registra solo; false: queda pendiente para confirmar el monto
  autoCreate  Boolean             @default(false)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, nextDate])
}

// Tope mensual de gasto por categoría principal, en dólares
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String   @unique
  amountUsd  Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavingsGoal {
  id         String    @id @default(cuid())
  userId     String
  name       String
  targetUsd  Decimal   @db.Decimal(18, 2)
  targetDate DateTime? @db.Date
  // Aporte mensual que la persona se propone (opcional); si falta, se usa lo necesario para llegar a la fecha
  monthlyUsd Decimal?  @db.Decimal(18, 2)
  color      String    @default("#1f6f78")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
}

// Aporte (positivo) o retiro (negativo) de una meta
model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  date      DateTime @db.Date
  amountUsd Decimal  @db.Decimal(18, 2)
  note      String?
  createdAt DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

model Debt {
  id           String        @id @default(cuid())
  userId       String
  direction    DebtDirection
  person       String
  personId     String?
  // Deuda creada por un movimiento compartido (siempre en USD, fijada con la tasa del día de la compra)
  sharedId     String?
  // La misma deuda vista desde la cuenta del familiar: los abonos se copian entre ambas
  linkedDebtId String?       @unique
  description  String?
  currency     Currency
  amount       Decimal       @db.Decimal(18, 2)
  dueDate      DateTime?     @db.Date
  settledAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  personRef  Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  shared     SharedExpense? @relation(fields: [sharedId], references: [id], onDelete: Cascade)
  payments   DebtPayment[]
  linkedDebt Debt?          @relation("DebtLink", fields: [linkedDebtId], references: [id], onDelete: SetNull)
  linkedFrom Debt?          @relation("DebtLink")

  @@index([userId])
  @@index([personId])
  @@index([sharedId])
}

model DebtPayment {
  id            String   @id @default(cuid())
  debtId        String
  date          DateTime @db.Date
  amount        Decimal  @db.Decimal(18, 2)
  note          String?
  // Cuenta donde entró (me pagaron) o de donde salió (pagué) el abono; mueve su saldo sin ser ingreso ni gasto
  accountId     String?
  // Monto en la moneda de la cuenta, si es distinta de la de la deuda
  accountAmount Decimal? @db.Decimal(18, 2)
  // Copia del abono que registró el familiar en su lado de la deuda
  mirrorOfId    String?  @unique
  createdAt     DateTime @default(now())

  debt     Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  account  Account?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  mirrorOf DebtPayment? @relation("PaymentMirror", fields: [mirrorOfId], references: [id], onDelete: Cascade)
  mirror   DebtPayment? @relation("PaymentMirror")

  @@index([debtId])
}

// Aviso para el usuario. dedupeKey evita repetir el mismo aviso (ej. un presupuesto excedido una vez por mes).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

// Persona con la que compartes gastos o tienes deudas
model Person {
  id           String   @id @default(cuid())
  userId       String
  name         String
  // Número de WhatsApp con código de país, solo dígitos (ej. 584121234567)
  phone        String?
  // Familiar que también usa la app: lo que compartes con esta persona aparece en su cuenta
  linkedUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedUser   User?               @relation("PersonLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  debts        Debt[]
  participants SharedParticipant[]
  paidShared   SharedExpense[]

  @@unique([userId, name])
  @@unique([userId, linkedUserId])
}

// Reparto de una compra entre varias personas. Montos en USD fijados con la tasa del día de la compra.
model SharedExpense {
  id             String    @id @default(cuid())
  userId         String
  // null: pagaste tú
  paidByPersonId String?
  splitMode      SplitMode
  totalUsd       Decimal   @db.Decimal(18, 2)
  // Copia en la cuenta de un familiar del reparto que registró otro (solo lectura para quien la recibe)
  mirrorOfId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mirrorOf     SharedExpense?      @relation("SharedMirror", fields: [mirrorOfId], references: [id], onDelete: Cascade)
  mirrors      SharedExpense[]     @relation("SharedMirror")
  paidBy       Person?             @relation(fields: [paidByPersonId], references: [id], onDelete: Restrict)
  participants SharedParticipant[]
  debts        Debt[]
  transaction  Transaction?
  plan         InstallmentPlan?

  @@index([userId])
  @@index([mirrorOfId])
}

model SharedParticipant {
  id        String  @id @default(cuid())
  sharedId  String
  // null: tú
  personId  String?
  pct       Decimal @db.Decimal(9, 6)
  amountUsd Decimal @db.Decimal(18, 2)

  shared SharedExpense @relation(fields: [sharedId], references: [id], onDelete: Cascade)
  person Person?       @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([sharedId])
}

// Compra en cuotas (Cashea y similares): inicial al comprar y cuotas fijas en USD
model InstallmentPlan {
  id             String               @id @default(cuid())
  userId         String
  provider       String
  store          String?
  description    String
  categoryId     String?
  purchaseDate   DateTime             @db.Date
  totalUsd       Decimal              @db.Decimal(18, 2)
  downPaymentUsd Decimal              @db.Decimal(18, 2)
  count          Int
  frequency      InstallmentFrequency
  // Cuenta con la que se pagó la inicial (vacía si la compra la hizo otra persona)
  accountId      String?
  rateSource     RateSource
  rateUsed       Decimal              @db.Decimal(18, 6)
  sharedId       String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account      Account?       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  shared       SharedExpense? @relation(fields: [sharedId], references: [id], onDelete: SetNull)
  installments Installment[]
  transactions Transaction[]

  @@index([userId])
}

model Installment {
  id            String   @id @default(cuid())
  planId        String
  n             Int
  dueDate       DateTime @db.Date
  amountUsd     Decimal  @db.Decimal(18, 2)
  // Movimiento con el que se pagó; vacío = pendiente
  transactionId String?  @unique

  plan        InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  transaction Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([planId, n])
  @@index([dueDate])
}

model Invitation {
  id          String         @id @default(cuid())
  kind        InvitationKind
  // SHA-256 del token: el enlace solo se muestra al crearlo
  tokenHash   String         @unique
  // Nombre sugerido para quien se invita
  name        String?
  // Usuario al que se le restablece la contraseña (RESET)
  userId      String?
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime       @default(now())

  user      User? @relation("InvitationTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
}
